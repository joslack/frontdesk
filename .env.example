# Copy to .env and fill in. scripts/make_secrets.py adds the passwords and keys that this project makes for itself.

# The self-hosted LangGraph Server checks this key when it starts, and every model call is traced with it. The
# project is frontdesk's own: give it another name here and in deploy/apps to trace somewhere else.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=frontdesk

# The desk agent and the retention desk (Anthropic), the gate (OpenAI's Decisions API), the workers (Fireworks).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FIREWORKS_API_KEY=
